# Public URL served by the remote-managed tunnel.
AIOSTREAMS_PUBLIC_URL=https://aio.example.com
# Public URL recorded by surrounding automation.
STACK_PUBLIC_URL=https://aio.example.com
# Application encryption key: exactly 64 hex characters, e.g. from openssl rand -hex 32.
AIOSTREAMS_SECRET_KEY=replace-with-64-hex-characters
# Administrative login in username:password form.
AIOSTREAMS_AUTH=admin:replace-with-a-strong-password
# Key required to create or edit configurations.
AIOSTREAMS_CONFIG_ACCESS_KEY=replace-with-a-long-random-value
# TorBox API key used to resolve streams.
TORBOX_API_KEY=replace-with-your-torbox-api-key
# TMDB API key used for metadata.
TMDB_API_KEY=replace-with-your-tmdb-api-key
# Token for a remotely managed Cloudflare tunnel.
MEDIA_GATEWAY_TUNNEL_TOKEN=replace-with-your-tunnel-token
# Restic repository URL for backups.
RESTIC_REPOSITORY=s3:https://storage.example.com/bucket
# Restic repository encryption password.
RESTIC_PASSWORD=replace-with-a-strong-password
# Object-storage access key for restic.
AWS_ACCESS_KEY_ID=replace-with-your-access-key
# Object-storage secret key for restic.
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
# Primary AIOStreams configuration identifier; leave empty for first bootstrap.
AIOSTREAMS_UUID=
# Primary AIOStreams configuration password; leave empty for first bootstrap.
AIOSTREAMS_PASSWORD=
